# ==============================================================================
# NeoFinesse Live AI Environment Configuration
# ==============================================================================
# Copy this file to '.env' and populate your provider API keys.
# The system supports Google Gemini, Groq, OpenAI, and Local (Ollama/vLLM) models.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary NeoFinesse Configuration
# ------------------------------------------------------------------------------
# Target provider: 'gemini', 'groq', 'openai', 'local', or 'mock' (default: mock)
NEOFINESSE_LLM_PROVIDER=gemini

# Model identifier or alias:
#   - Gemini: 'gemini-3.7-flash', 'gemini-3.8-flash', 'gemini-2.5-flash', 'gemini-2.0-flash'
#   - Groq:   'openai/gpt-oss-20b', 'openai/gpt-oss-120b', 'llama-3.3-70b-versatile'
#   - OpenAI: 'gpt-4o-mini', 'gpt-4o'
NEOFINESSE_LLM_MODEL=gemini-3.7-flash

# Primary API Key (can also use provider-specific variables below)
NEOFINESSE_LLM_API_KEY=your_api_key_here

# Optional: Custom base URL (e.g., for Ollama: http://localhost:11434/v1)
# NEOFINESSE_LLM_BASE_URL=http://localhost:11434/v1

# Request timeout in seconds (default: 30)
NEOFINESSE_LLM_TIMEOUT=30

# ------------------------------------------------------------------------------
# 2. Provider-Specific API Keys (Supported Fallbacks)
# ------------------------------------------------------------------------------
# If set, NeoFinesse can automatically detect the provider without NEOFINESSE_LLM_PROVIDER.

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq Cloud (https://console.groq.com/)
GROQ_API_KEY=

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Quick-Config Preset Examples
# ------------------------------------------------------------------------------
# Preset A: Google Gemini 3.7 Flash
# NEOFINESSE_LLM_PROVIDER=gemini
# NEOFINESSE_LLM_MODEL=gemini-3.7-flash
# GEMINI_API_KEY=AIzaSy...

# Preset B: Google Gemini 3.8 Flash
# NEOFINESSE_LLM_PROVIDER=gemini
# NEOFINESSE_LLM_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=AIzaSy...

# Preset C: Groq OpenAI OSS 20B
# NEOFINESSE_LLM_PROVIDER=groq
# NEOFINESSE_LLM_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=gsk_...

# Preset D: Groq OpenAI OSS 120B
# NEOFINESSE_LLM_PROVIDER=groq
# NEOFINESSE_LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=gsk_...

# ------------------------------------------------------------------------------
# 4. Phase 7.2.3 Controlled Benchmark Configuration
# ------------------------------------------------------------------------------
# These settings govern rate-pacing and retry behaviour for the controlled benchmark.
# They apply to any run that uses GenericLLMClient (offline + online).

# Inter-request delay in seconds to respect API rate limits.
# Free tier recommendation: 4 seconds (15 RPM × 4s ≈ safe headroom).
# Set to 0 to disable pacing (not recommended for free-tier keys).
NEOFINESSE_LLM_REQUEST_DELAY_SECONDS=4

# Maximum number of retries for a single request on HTTP 429 (quota exhaustion).
# Each retry uses exponential backoff (2s, 4s, 8s … capped at 60s).
# Set to 0 to disable retries.
NEOFINESSE_LLM_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. Testing / CI Flags
# ------------------------------------------------------------------------------
# Set to 1 to allow live remote LLM tests to run during CI.
# NEOFINESSE_RUN_LIVE_TESTS=0

